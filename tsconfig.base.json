{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // The runtime strips types rather than compiling them, so anything that needs a code
    // transform — parameter properties, enums, namespaces — must fail at type-check time
    // instead of at the first test run.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "forceConsistentCasingInFileNames": true
  }
}
