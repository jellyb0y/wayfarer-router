# The runtime the device installs, pinned with its checksums.
#
# The checksums are in the repository on purpose. This is an archive fetched over the
# network onto a device that routes other people's traffic; an unverified download there
# is the cheapest supply-chain hole available, and "it came from the official host over
# TLS" is an argument about the transport, not about the bytes.
#
# Values are from https://nodejs.org/dist/v24.21.0/SHASUMS256.txt, retrieved 2026-09-19.
# Raising the version means replacing both the version and the matching checksums here;
# the installer refuses on a mismatch and does not fall back.
NODE_VERSION=v24.21.0
NODE_SHA256_linux_arm64=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2
NODE_SHA256_linux_x64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
NODE_BASE_URL=https://nodejs.org/dist
