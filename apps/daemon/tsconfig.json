{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The bundler resolves the .ts extensions the source imports with, so tsc is used for
    // type-checking only and emits nothing.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "composite": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "test"]
}
